# Synksar Auto Publisher - Environment Variables Configuration

# 1. ቴሌግራም ቦት ቶከን (ከ @BotFather የሚገኝ)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. የቴሌግራም ቻናል መታወቂያ (ምሳሌ፡ @yourchannel ወይም -100xxxxxxxxxx)
CHANNEL_ID=@atsedetiguhan

# 3. የአስተዳዳሪ የቴሌግራም ID ቁጥሮች (በኮማ የተከፋፈሉ፣ ምሳሌ፡ 12345678,87654321)
# የራስዎን ID ለማወቅ በቴሌግራም @userinfobot ን ማናገር ይችላሉ
ADMIN_IDS=123456789

# 4. የሰዓት ዞን እና የህትመት ሰዓት (በኢትዮጵያ ሰዓት እኩለ ሌሊት 12:00 AM)
TIMEZONE=Africa/Addis_Ababa
PUBLISH_HOUR=0
PUBLISH_MINUTE=0

# 5. የኢትዮጵያ ዓመት
DEFAULT_YEAR=2018

# 6. የድር ዳሽቦርድ ቅንብሮች
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=synksar-secret-change-this-in-production

# 7. የማኅበራዊ ገጾች ሊንኮች (የቦት ሊንክ የለም!)
CHANNEL_LINK_NAME=telegram channel
CHANNEL_LINK_URL=https://t.me/atsedetiguhan

GROUP_LINK_NAME=Telegram group
GROUP_LINK_URL=https://t.me/atsedetiguhan_group

SUNDAY_SCHOOL_AMHARIC=አጸደ ትጉሃን ሰንበት ትምህርት ቤት
SUNDAY_SCHOOL_ENGLISH=Atsede tguhan sunday school
